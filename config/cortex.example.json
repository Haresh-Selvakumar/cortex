{
  "version": 1,
  "providers": {
    "ollama": {"base_url": "http://localhost:11434", "timeout": 30},
    "openai": {"api_key_env": "OPENAI_API_KEY", "timeout": 30},
    "anthropic": {"api_key_env": "ANTHROPIC_API_KEY", "timeout": 30}
  },
  "roles": {"classifier": "local-classifier", "planner": "local-worker", "worker": null},
  "models": [
    {"id": "local-classifier", "provider": "ollama", "model": "qwen2.5:3b-instruct",
     "task_types": ["analysis", "coding", "documents", "scheduling", "mixed"],
     "capabilities": ["text_generation", "structured_output", "classification"],
     "structured_output": true, "tools": false, "enabled": true, "priority": 10, "pricing": {}},
    {"id": "local-worker", "provider": "ollama", "model": "qwen2.5:7b-instruct",
     "task_types": ["analysis", "coding", "documents"],
     "capabilities": ["analysis", "text_generation", "structured_output", "quote_extraction", "code_generation", "document_draft"],
     "structured_output": true, "tools": false, "enabled": true, "priority": 20, "pricing": {}},
    {"id": "openai-configured", "provider": "openai", "model_env": "CORTEX_OPENAI_MODEL",
     "task_types": ["analysis", "coding", "documents"],
     "capabilities": ["analysis", "text_generation", "structured_output", "classification", "quote_extraction", "code_generation", "document_draft"],
     "structured_output": true, "tools": false, "enabled": true, "priority": 30, "pricing": {}},
    {"id": "anthropic-configured", "provider": "anthropic", "model_env": "CORTEX_ANTHROPIC_MODEL",
     "task_types": ["analysis", "coding", "documents"],
     "capabilities": ["analysis", "text_generation", "structured_output", "classification", "quote_extraction", "code_generation", "document_draft"],
     "structured_output": true, "tools": false, "enabled": true, "priority": 30, "pricing": {}}
  ]
}
